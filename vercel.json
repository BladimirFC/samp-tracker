{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/discord", "dest": "/api/discord.ts" },
    { "src": "/api/(.*)", "dest": "/api?apipath=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
