{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/discord-bot", "dest": "/api/discord-bot.ts" },
    { "src": "/api/(.*)", "dest": "/api?apipath=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/discord-bot.ts": {
      "maxDuration": 10
    }
  }
}
